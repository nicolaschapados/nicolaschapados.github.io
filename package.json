{
  "name": "chapados-ca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nicolas Chapados' personal site: biography, publications, talks, blog. Built with Astro, deployed to GitHub Pages.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "cv-sync": "node scripts/cv-sync.mjs",
    "test": "npm run build && vitest run",
    "test:build": "vitest run --project build",
    "test:sync": "vitest run --project sync"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "katex": "^0.18.6",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
