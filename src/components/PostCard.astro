---
import type { CollectionEntry } from 'astro:content';
import { t, localePath, type Locale } from '../i18n/ui';
interface Props { post: CollectionEntry<'posts'>; locale: Locale; }
const { post, locale } = Astro.props;
const tr = t(locale);
const slug = post.id.split('/').pop()!;
const foreign = post.data.locale !== locale;
const href = localePath(post.data.locale, `blog/${slug}`);
const date = post.data.date.toLocaleDateString(locale === 'fr' ? 'fr-CA' : 'en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
---
<article class="post-card">
  <a class="serif title" href={href} lang={foreign ? post.data.locale : undefined}>{post.data.title}</a>
  <p class="summary">{post.data.summary}</p>
  <div class="meta"><time datetime={post.data.date.toISOString()}>{date}</time>{foreign && <span class="foreign"> · {tr('blog.otherLocale')}</span>}</div>
</article>
<style>
  .post-card { display: flex; flex-direction: column; gap: 8px; }
  .title { font-size: 26px; line-height: 1.25; color: var(--fg); }
  .summary { margin: 0; font-size: 15px; }
  .meta { font-size: 13px; color: var(--mute); }
</style>
