---
import type { Locale } from '../i18n/ui';
interface Props { id: string; locale: Locale }
const { id, locale } = Astro.props;
// ChatGPT conceptual syntheses. The exact prompts are archived in docs/design/homepage-options/prompts.json.
const images: Record<string, { image: string; label: string }> = {
  oreshkin2019n: { image: 'nbeats', label: 'N-BEATS' },
  lozhkov2024starcoder2: { image: 'starcoder2', label: 'StarCoder2' },
  behnamghader2024llm2vec: { image: 'llm2vec', label: 'LLM2Vec' },
  drouin2024workarena: { image: 'workarena', label: 'WorkArena' },
  'talk-01': { image: 'context-is-key', label: 'Context is Key' },
  'talk-02': { image: 'workarenapp', label: 'WorkArena++' },
  'talk-03': { image: 'browsergym', label: 'BrowserGym' },
};
const illustration = images[id];
const label = illustration && `${locale === 'fr' ? 'Voir la synthèse visuelle générée par ChatGPT' : 'View ChatGPT-generated visual synthesis'} — ${illustration.label}`;
---
{illustration && <a class="thumbnail" href={`/images/synthesis/${illustration.image}.webp`} aria-label={label} title={label}>
  <img src={`/images/synthesis/${illustration.image}.webp`} alt="" width="512" height="512" loading="lazy" decoding="async" />
</a>}
