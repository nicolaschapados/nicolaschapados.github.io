---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, locales, type Locale } from '../../i18n/ui';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const locale = Astro.params.lang as Locale;
const tr = t(locale);
const talks = (await getCollection('talks')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const fmt = (d: string) => new Date(`${d}-15`).toLocaleDateString(locale === 'fr' ? 'fr-CA' : 'en-CA', { year: 'numeric', month: 'long' });
const kindLabel: Record<string, Record<Locale, string>> = { keynote: { en: 'Keynote', fr: 'Conférence plénière' }, lecture: { en: 'Guest lecture', fr: 'Cours magistral' }, invited: { en: 'Invited talk', fr: 'Présentation invitée' }, panel: { en: 'Panel', fr: 'Table ronde' } };
---
<Base locale={locale} title={tr('talks.title')} path="talks">
  <section class="wrap" style="padding-top: 32px;">
    <h1>{tr('talks.title')}</h1>
    <p class="intro">{tr('talks.intro')}</p>
    <ol class="talks">
      {talks.map((k) => (
        <li>
          <div class="when"><time datetime={k.data.date}>{fmt(k.data.date)}</time><span class="kind">{kindLabel[k.data.kind][locale]}</span></div>
          <div class="what">
            <div class="serif title">{typeof k.data.title === 'string' ? k.data.title : k.data.title[locale]}</div>
            <div class="event">{k.data.event}{k.data.with.length > 0 && <span> · {tr('talks.with')} {k.data.with.join(', ')}</span>}</div>
            {k.data.recording && <a class="rec" href={k.data.recording} rel="external">{tr('talks.recording')}</a>}
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>
<style>
  .intro { max-width: var(--measure); margin: 20px 0 40px; }
  .talks { list-style: none; margin: 0; padding: 0; max-width: 900px; }
  .talks li { display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .when { display: flex; flex-direction: column; gap: 4px; font-size: 14px; color: var(--mute); }
  .kind { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; }
  .title { font-size: 22px; line-height: 1.3; }
  .event { font-size: 15px; color: var(--sub); margin-top: 4px; }
  .rec { display: inline-block; margin-top: 8px; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; }
  @media (max-width: 720px) { .talks li { grid-template-columns: 1fr; gap: 6px; } }
</style>
