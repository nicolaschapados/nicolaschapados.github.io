---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { t, localePath, locales, type Locale } from '../../i18n/ui';
import portrait from '../../assets/portrait.jpg';

export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const locale = Astro.params.lang as Locale;
const tr = t(locale);

const selected = (await getCollection('selected')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const selectedPubs = (await Promise.all(selected.map(async (s) => ({ s, p: await getEntry('publications', s.data.key) })))).filter((x) => x.p);
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts.find((p) => p.data.locale === locale) ?? posts[0];
const talks = (await getCollection('talks')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 3);
const fmtMonth = (d: string) => new Date(`${d}-15`).toLocaleDateString(locale === 'fr' ? 'fr-CA' : 'en-CA', { year: 'numeric', month: 'long' });
---
<Base locale={locale} title={tr('site.name')} path="">
  <section class="wrap hero">
    <div class="frame"><Image class="portrait" src={portrait} alt={locale === 'fr' ? 'Nicolas Chapados en conférence' : 'Nicolas Chapados speaking on stage'} widths={[400, 640, 1000]} sizes="(max-width: 720px) 60vw, 420px" loading="eager" /></div>
    <div class="copy">
      <div class="lab">{tr('site.tagline')}</div>
      <h1>{tr('hero.title.a')}<em>{tr('hero.title.b')}</em></h1>
      <p class="lede">{tr('hero.lede')}</p>
      <div class="ctas">
        <a class="btn-line" href={localePath(locale, 'about')}>{tr('hero.bio')}</a>
        <a class="btn-line quiet" href="/cv.pdf">{tr('nav.cv')}</a>
      </div>
    </div>
  </section>
  <section class="wrap band">
    <div class="card">
      <div class="lab">{tr('home.selected')}</div>
      <ul class="sel">
        {selectedPubs.map(({ s, p }) => (
          <li><a class="serif" href={`${localePath(locale, 'publications')}#${p!.data.key}`}>{p!.data.title.split(':')[0]}</a><div class="sub">{s.data.note[locale]}{p!.data.venue ? ` · ${p!.data.venue.split(',')[0]} ${p!.data.year}` : ` · ${p!.data.year}`}</div></li>
        ))}
      </ul>
      <a class="lab more" href={localePath(locale, 'publications')}>{tr('home.allPublications')}</a>
    </div>
    <div class="card">
      <div class="lab">{tr('home.blog')}</div>
      {latest ? <PostCard post={latest} locale={locale} /> : <p>{tr('home.noPost')}</p>}
      <a class="lab more" href={localePath(locale, 'blog')}>{tr('home.allPosts')}</a>
    </div>
    <div class="card">
      <div class="lab">{tr('home.speaking')}</div>
      <ul class="sel">
        {talks.map((k) => (
          <li>{k.data.recording ? <a class="serif" href={k.data.recording}>{typeof k.data.title === 'string' ? k.data.title : k.data.title[locale]}</a> : <span class="serif">{typeof k.data.title === 'string' ? k.data.title : k.data.title[locale]}</span>}<div class="sub">{k.data.event} · {fmtMonth(k.data.date)}</div></li>
        ))}
      </ul>
      <a class="lab more" href={localePath(locale, 'talks')}>{tr('home.allTalks')}</a>
    </div>
  </section>
</Base>
<style>
  .hero { display: grid; grid-template-columns: 5fr 7fr; gap: 64px; align-items: center; padding-top: 40px; padding-bottom: 72px; }
  .copy { display: flex; flex-direction: column; gap: 28px; }
  .lede { font-size: 18px; max-width: 540px; margin: 0; }
  .ctas { display: flex; gap: 32px; }
  .band { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .card { display: flex; flex-direction: column; gap: 16px; }
  .sel { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .sel a, .sel .serif { font-size: 21px; line-height: 1.3; color: var(--fg); }
  .sel a:hover { color: var(--acc); }
  .sub { font-size: 14px; color: var(--mute); margin-top: 2px; }
  .more { color: var(--acc); margin-top: auto; }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; gap: 32px; } .frame { max-width: 260px; } .band { grid-template-columns: 1fr; } }
</style>
