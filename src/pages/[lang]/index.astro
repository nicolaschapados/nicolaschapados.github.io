---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import ContributionThumbnail from '../../components/ContributionThumbnail.astro';
import LinkedOrganizations from '../../components/LinkedOrganizations.astro';
import { t, localePath, locales, blogEnabled, type Locale } from '../../i18n/ui';
import portrait from '../../assets/portrait.jpg';
import '../../styles/homepage.css';

export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const locale = Astro.params.lang as Locale;
const tr = t(locale);

const selected = (await getCollection('selected')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const selectedPubs = (await Promise.all(selected.map(async (s) => ({ s, p: await getEntry('publications', s.data.key) })))).filter((x) => x.p);
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts.find((p) => p.data.locale === locale) ?? posts[0];
const talks = (await getCollection('talks')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 3);
const fmtMonth = (d: string) => new Date(`${d}-15`).toLocaleDateString(locale === 'fr' ? 'fr-CA' : 'en-CA', { year: 'numeric', month: 'long', timeZone: 'UTC' });
---
<Base locale={locale} title={tr('site.name')} path="">
  <section class="wrap home-hero">
    <div class="frame"><Image class="portrait" src={portrait} alt={locale === 'fr' ? 'Nicolas Chapados en conférence' : 'Nicolas Chapados speaking on stage'} widths={[400, 640, 1000]} sizes="(max-width: 720px) 60vw, 420px" loading="eager" /></div>
    <div class="copy">
      <div class="lab">{tr('site.tagline')}</div>
      <h1>{tr('hero.title.a')}<em>{tr('hero.title.b')}</em></h1>
      <p class="lede"><LinkedOrganizations text={tr('hero.lede')} locale={locale} /></p>
      <div class="ctas">
        <a class="btn-line" href={localePath(locale, 'about')}>{tr('hero.bio')}</a>
        <a class="btn-line quiet" href="/cv.pdf">{tr('nav.cv')}</a>
      </div>
    </div>
  </section>
  <section class="wrap band home-contributions">
    <div class="card">
      <div class="lab">{tr('home.selected')}</div>
      <ul class="sel">
        {selectedPubs.map(({ s, p }) => (
          <li><ContributionThumbnail id={s.data.key} locale={locale} /><div class="entry-copy"><a class="serif" href={`${localePath(locale, 'publications')}#${p!.data.key}`}>{p!.data.title.split(':')[0]}</a><div class="sub">{s.data.note[locale]}{p!.data.venue ? ` · ${p!.data.venue.split(',')[0]} ${p!.data.year}` : ` · ${p!.data.year}`}</div></div></li>
        ))}
      </ul>
      <a class="lab more" href={localePath(locale, 'publications')}>{tr('home.allPublications')}</a>
    </div>
    {blogEnabled && <div class="card">
      <div class="lab">{tr('home.blog')}</div>
      {latest ? <PostCard post={latest} locale={locale} /> : <p>{tr('home.noPost')}</p>}
      <a class="lab more" href={localePath(locale, 'blog')}>{tr('home.allPosts')}</a>
    </div>}
    <div class="card">
      <div class="lab">{tr('home.speaking')}</div>
      <ul class="sel">
        {talks.map((k) => (
          <li><ContributionThumbnail id={k.id} locale={locale} /><div class="entry-copy">{k.data.recording ? <a class="serif" href={k.data.recording}>{typeof k.data.title === 'string' ? k.data.title : k.data.title[locale]}</a> : <span class="serif">{typeof k.data.title === 'string' ? k.data.title : k.data.title[locale]}</span>}<div class="sub">{k.data.event} · {fmtMonth(k.data.date)}</div></div></li>
        ))}
      </ul>
      <a class="lab more" href={localePath(locale, 'talks')}>{tr('home.allTalks')}</a>
    </div>
    <div class="card news-card">
      <div class="lab">{tr('home.news')}</div>
      <div class="news-item">
        <time class="news-date" datetime="2026-09-08">{locale === 'fr' ? '8 septembre 2026' : 'September 8, 2026'}</time>
        <a class="serif" href="https://www.linkedin.com/feed/update/urn:li:activity:7503149578171494400/">{tr('home.neraLaunch')}</a>
        <p class="sub"><LinkedOrganizations text={tr('home.neraLaunchNote')} locale={locale} /></p>
        <a class="news-link" href="https://www.linkedin.com/feed/update/urn:li:activity:7503149578171494400/">{tr('home.readAnnouncement')} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>
