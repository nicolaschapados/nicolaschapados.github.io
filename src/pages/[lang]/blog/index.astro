---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { t, locales, localePath, type Locale } from '../../../i18n/ui';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const locale = Astro.params.lang as Locale;
const tr = t(locale);
const all = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// One entry per translationKey: prefer this locale's version, else list the other with a marker.
const seen = new Set<string>();
const posts = all.filter((p) => p.data.locale === locale).concat(all.filter((p) => p.data.locale !== locale)).filter((p) => { if (seen.has(p.data.translationKey)) return false; seen.add(p.data.translationKey); return true; }).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base locale={locale} title={tr('blog.title')} path="blog">
  <section class="wrap" style="padding-top: 32px;">
    <h1>{tr('blog.title')}</h1>
    <p class="intro">{tr('blog.intro')} <a href={localePath(locale, 'rss.xml').replace(/\/$/, '')}>{tr('blog.rss')}</a></p>
    <div class="posts">{posts.map((p) => <PostCard post={p} locale={locale} />)}</div>
  </section>
</Base>
<style>
  .intro { max-width: var(--measure); margin: 20px 0 40px; }
  .posts { display: flex; flex-direction: column; gap: 36px; max-width: 760px; }
</style>
