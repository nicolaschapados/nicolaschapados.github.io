---
// Root: a client-side redirect on stored choice then browser language (ADR 0003).
// The site is static, so Astro.preferredLocale is unavailable; no-script and crawlers fall back to /en/.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nicolas Chapados</title>
    <meta name="description" content="Nicolas Chapados: machine learning researcher and company builder. Biography, publications, talks." />
    <link rel="canonical" href="https://chapados.ca/en/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nicolas Chapados" />
    <meta property="og:title" content="Nicolas Chapados" />
    <meta property="og:description" content="Machine learning researcher and company builder. Biography, publications, talks." />
    <meta property="og:url" content="https://chapados.ca/" />
    <meta property="og:image" content="https://chapados.ca/og-default.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Nicolas Chapados" />
    <meta name="twitter:image" content="https://chapados.ca/og-default.jpg" />
    <link rel="alternate" hreflang="en-CA" href="https://chapados.ca/en/" />
    <link rel="alternate" hreflang="fr-CA" href="https://chapados.ca/fr/" />
    <link rel="alternate" hreflang="x-default" href="https://chapados.ca/en/" />
    <script is:inline>
      (function () {
        var target = '/en/';
        try {
          var stored = localStorage.getItem('locale');
          if (stored === 'fr' || stored === 'en') target = '/' + stored + '/';
          else if (/^fr\b/i.test(navigator.language || '')) target = '/fr/';
        } catch (e) {}
        location.replace(target);
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/en/" /></noscript>
    <style>body{margin:0;background:#101418;color:#e7e2d8;font-family:Georgia,serif;display:grid;place-items:center;min-height:100vh}a{color:#d3b26a}</style>
  </head>
  <body>
    <p><a href="/en/">English</a> · <a href="/fr/">Français</a></p>
  </body>
</html>
