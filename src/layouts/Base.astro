---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, otherLocale, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Path of this page without locale prefix, e.g. "publications" or "blog/my-post". Used for alternate links. */
  path: string;
  /** When the other-locale twin lives at a different path (untranslated post), pass it; null hides the alternate. */
  altPath?: string | null;
  image?: string;
}
const { locale, title, description, path, altPath, image = '/og-default.jpg' } = Astro.props;
const tr = t(locale);
const site = Astro.site ?? new URL('https://chapados.ca');
const canonical = new URL(localePath(locale, path), site).href;
const other = otherLocale(locale);
const alternate = altPath === null ? null : new URL(localePath(other, altPath ?? path), site).href;
const fullTitle = title === tr('site.name') ? title : `${title} · ${tr('site.name')}`;
---
<!doctype html>
<html lang={locale === 'fr' ? 'fr-CA' : 'en-CA'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? tr('site.description')} />
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" hreflang={other === 'fr' ? 'fr-CA' : 'en-CA'} href={alternate} />}
    <link rel="alternate" hreflang={locale === 'fr' ? 'fr-CA' : 'en-CA'} href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${tr('site.name')} · ${tr('blog.rss')}`} href={localePath(locale, 'rss.xml').replace(/\/$/, '')} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? tr('site.description')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site).href} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_CA' : 'en_CA'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400&display=swap" />
    <script is:inline>
      // Theme: stored override wins, otherwise the system preference. Runs before paint to avoid a flash.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch (e) { document.documentElement.dataset.theme = 'light'; }
      })();
    </script>
  </head>
  <body>
    <Header locale={locale} path={path} altPath={altPath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
